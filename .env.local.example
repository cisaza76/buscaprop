# BuscaProp — variables de entorno
# Copia este archivo a .env.local y rellena con tus credenciales reales.
# En producción todas viven en Vercel (Project → Settings → Environment Variables),
# NO en este archivo.

# ── Supabase ────────────────────────────────────────────────────────────────
# Settings → API en https://app.supabase.com/project/_/settings/api

# URL pública del proyecto Supabase (ej: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon key pública (segura para el navegador, respeta RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (SOLO server-side / scrapers — NUNCA exponer al cliente).
# Bypassa RLS: tratar como secreto crítico.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto del webhook de Supabase → /api/leads/notify (Bearer token, timing-safe).
# Sin esto el webhook responde 401 y las notificaciones de leads NO se envían.
SUPABASE_WEBHOOK_SECRET=

# ── AI (Anthropic) ───────────────────────────────────────────────────────────
# API key de Claude (https://console.anthropic.com). El agente del chat la usa.
ANTHROPIC_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# API key de Resend para enviar emails de leads y solicitudes de visita.
RESEND_API_KEY=

# Destino de las notificaciones de leads/visitas (email del equipo comercial).
# Sin esto, los emails NO se envían (la data igual queda persistida en la BD).
LEADS_NOTIFY_TO=

# ── Admin / Cron ─────────────────────────────────────────────────────────────
# Lista separada por comas de emails con acceso a /api/analytics y
# /api/admin/*. Sin esto, esos endpoints responden 500 (fail-closed).
ADMIN_EMAILS=

# Bearer secret que protege /api/cron/scrape (disparo de scrapers).
CRON_SECRET=

# ── Scraper orchestration (Inngest) ──────────────────────────────────────────
# Keys de Inngest (https://app.inngest.com). En dev local pueden ir vacías
# (Inngest dev server). En producción son requeridas.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# URL base pública del sitio (usada en links de emails de notificación).
NEXT_PUBLIC_SITE_URL=https://buscaprop.co

# URL de la app en dev (opcional).
NEXT_PUBLIC_APP_URL=http://localhost:3001

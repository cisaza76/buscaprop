# BuscaProp — variables de entorno
# Copia este archivo a .env.local y rellena con tus credenciales reales de Supabase.
# Settings → API en https://app.supabase.com/project/_/settings/api

# URL pública del proyecto Supabase (ej: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon key pública (segura para el navegador, respeta RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (SOLO para uso server-side / scrapers — NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=
